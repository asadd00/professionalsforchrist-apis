generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}


datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}


model User {
    id              Int @id @default(autoincrement())
    name            String
    email           String
    phone           String?
    city            String?
    residentialArea String?
    password        String?
    socialId        String? @unique
    loginType       String
    isActive        Boolean @default(true)
    role            UserRole @default(user)
    lastLogin       Int?
    appVersion      String?
    appPlatform     String?   

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    deletedAt       DateTime?

    @@unique([email, loginType])

    professionals       Professional[]
    businesses          Business[]
    deviceTokens        DeviceToken[]
    prayerRequests      PrayerRequest[]
    notifications       Notification[]
    notificationReads   NotificationRead[]

    @@map("user")
}

model Notification {
    id        Int @id @default(autoincrement())
    title     String
    body      String
    imageUrl  String?
    userId    Int? // null = broadcast, visible to every user

    createdAt DateTime @default(now())

    user      User? @relation(fields: [userId], references: [id], onDelete: Cascade)
    reads     NotificationRead[]

    @@map("notification")
}

model NotificationRead {
    id             Int @id @default(autoincrement())
    notificationId Int
    userId         Int

    readAt         DateTime @default(now())

    notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
    user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([notificationId, userId])
    @@map("notification_read")
}

enum UserRole {
  user
  admin
}

model Professional {
    id                          Int @id @default(autoincrement())
    name                        String
    email                       String?
    contactNumber               String
    shouldNumberVisible         Boolean
    gender                      Gender
    churchName                  String
    churchArea                  String
    city                        String
    lastEducationId             Int?
    lastDegreeName              String?
    lastInstituteAttended       String?
    isEmployed                  Boolean
    occupation                  String
    industryId                  Int
    otherIndustry               String?
    jobTitle                    String
    employer                    String
    yearsOfExperience           String?
    lastEmployer1               String?
    lastEmployer2               String?
    lastEmployer3               String?
    residentialArea             String
    linkedInUrl                 String?
    notes                       String?
    dateOfBirth                 String?
    isVerified                  Boolean @default(false)
    createdById                 Int

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    deletedAt       DateTime?

    createdByUser      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
    education      Education?      @relation(fields: [lastEducationId], references: [id])
    industry       Industry       @relation(fields: [industryId], references: [id])

    @@map("professional")
}

model Education {
    id          Int @id @default(autoincrement())
    name        String  @unique
    isActive    Boolean @default(true)

    professional    Professional[]

    @@map("education")
}

model Industry {
    id          Int @id @default(autoincrement())
    name        String  @unique
    isActive    Boolean @default(true)

    professional        Professional[]
    notableBusinesses   NotableBusiness[]
    communityLeaders    CommunityLeader[]

    @@map("industry")
}

enum RegisterFor {
  self
  someoneElse
}

enum Gender {
  male
  female
  other
}

model Business {
    id                          Int @id @default(autoincrement())
    registerFor                 RegisterFor
    ownerName                   String
    businessType                String
    yearsOfExperience           String
    email                       String?
    contactNumber               String
    city                        String
    residentialArea             String
    website                     String?
    fbPage                      String?
    instaPage                   String?
    linkedInUrl                 String?
    notes                       String?
    createdById                 Int
    dateOfBirth                 String
    isVerified                  Boolean @default(false)

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    deletedAt       DateTime?

    createdByUser      User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

    @@map("business")
}

model DeviceToken {
    id          Int @id @default(autoincrement())
    userId      Int
    token       String @unique
    platform    String?

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("device_token")
}

model NotableBusiness {
    id            Int @id @default(autoincrement())
    name          String
    industryId    Int?
    city          String
    contribution  String
    website       String?
    facebook      String?
    instagram     String?
    linkedin      String?
    whatsapp      String?
    phone         String?
    isVerified    Boolean @default(false)

    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    industry      Industry? @relation(fields: [industryId], references: [id])

    @@map("notable_business")
}

model CommunityLeader {
    id            Int @id @default(autoincrement())
    name          String
    industryId    Int?
    city          String
    contribution  String
    website       String?
    facebook      String?
    instagram     String?
    linkedin      String?
    whatsapp      String?
    phone         String?
    isVerified    Boolean @default(false)

    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    deletedAt     DateTime?

    industry      Industry? @relation(fields: [industryId], references: [id])

    @@map("community_leader")
}

model PrayerType {
    id          Int @id @default(autoincrement())
    name        String @unique
    isActive    Boolean @default(true)

    prayerRequests  PrayerRequest[]

    @@map("prayer_type")
}

model PrayerRequest {
    id              Int @id @default(autoincrement())
    fullName        String
    contactNumber   String
    email           String?
    isAnonymous     Boolean @default(false)
    prayerTypeId    Int
    prayerText      String
    isPrayed        Boolean @default(false)
    prayedAt        DateTime?
    createdById     Int

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    deletedAt       DateTime?

    prayerType      PrayerType @relation(fields: [prayerTypeId], references: [id])
    createdByUser   User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

    @@map("prayer_request")
}

model EducationFund {
    id            Int @id @default(autoincrement())
    totalFund     Decimal @default(0) @db.Decimal(14, 2)
    fundUtilized  Decimal @default(0) @db.Decimal(14, 2)

    updatedAt     DateTime @updatedAt

    @@map("education_fund")
}

model PodcastSettings {
    id          Int @id @default(autoincrement())
    youtubeUrl  String?

    updatedAt   DateTime @updatedAt

    @@map("podcast_settings")
}