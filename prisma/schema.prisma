generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}


datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}


model User {
    id              Int @id @default(autoincrement())
    name            String
    email           String
    phone           String?
    password        String?
    socialId        String? @unique
    loginType       String
    isActive        Boolean @default(true)
    role            UserRole @default(user)
    lastLogin       Int?
    appVersion      String?
    appPlatform     String?   

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    deletedAt       DateTime?

    @@unique([email, loginType])

    @@map("user")
}

enum UserRole {
  user
  admin
}

model Professional {
    id                          Int @id @default(autoincrement())
    registerFor                 RegisterFor
    name                        String
    email                       String
    contactNumber               String
    shouldNumberVisible         Boolean
    gender                      Gender
    churchName                  String
    churchArea                  String
    city                        String
    lastEducationId             Int
    lastDegreeName              String
    lastInstituteAttended       String
    isEmployed                  Boolean
    occupation                  String
    industryId                  Int?
    otherIndustry               String?
    jobTitle                    String?
    employer                    String?
    yearsOfExperience           String
    lastEmployer1               String?
    lastEmployer2               String?
    lastEmployer3               String?
    residentialAddress          String
    residentialArea             String
    linkedInUrl                 String?
    notes                       String?
    dateOfBirth                 String
    isVerified                  Boolean @default(false)
    createdById                 Int

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    deletedAt       DateTime?

    education      Education      @relation(fields: [lastEducationId], references: [id])
    industry       Industry?       @relation(fields: [industryId], references: [id])

    @@map("professional")
}

model Education {
    id          Int @id @default(autoincrement())
    name        String  @unique
    isActive    Boolean @default(true)

    professional    Professional[]

    @@map("education")
}

model Industry {
    id          Int @id @default(autoincrement())
    name        String  @unique
    isActive    Boolean @default(true)

    professional    Professional[]

    @@map("industry")
}

enum RegisterFor {
  self
  someoneElse
}

enum Gender {
  male
  female
}

model Business {
    id                          Int @id @default(autoincrement())
    registerFor                 RegisterFor
    ownerName                   String
    businessType                String
    yearsOfExperience           String
    email                       String?
    contactNumber               String
    city                        String
    residentialArea             String
    website                     String?
    fbPage                      String?
    instaPage                   String?
    linkedInUrl                 String?
    notes                       String?
    createdById                 Int
    dateOfBirth                 String
    isVerified                  Boolean @default(false)

    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt
    deletedAt       DateTime?

    @@map("business")
}